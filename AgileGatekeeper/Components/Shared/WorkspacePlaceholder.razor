<div class="w-full flex-1 min-h-[460px] rounded-2xl border border-dashed border-slate-200/90 dark:border-slate-800/80 bg-white/40 dark:bg-slate-900/20 flex flex-col items-center justify-center p-8 text-center transition-all">
    <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-slate-800 border border-blue-100 dark:border-slate-700/60 flex items-center justify-center mb-3 text-blue-600 dark:text-blue-400 shadow-xs">
        <span class="material-symbols-outlined text-[24px]">@Icon</span>
    </div>

    <h2 class="font-display text-[18px] font-bold text-slate-900 dark:text-white tracking-tight mb-1">
        @Title
    </h2>

    <p class="text-[13px] text-slate-400 dark:text-slate-500 max-w-sm leading-normal mb-4">
        @Description
    </p>

    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100/80 dark:bg-slate-800 border border-slate-200/70 dark:border-slate-700 text-slate-600 dark:text-slate-300 text-[11.5px] font-medium">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-600 animate-pulse"></span>
        <span>@StatusText</span>
    </div>

    @if (ChildContent is not null)
    {
        <div class="mt-6 w-full">
            @ChildContent
        </div>
    }
</div>

@code {
    [Parameter]
    public string Title { get; set; } = "Área de Contenido Vacía";

    [Parameter]
    public string Description { get; set; } = "Espacio despejado y listo para integrar los paneles y módulos operativos del sistema.";

    [Parameter]
    public string Icon { get; set; } = "dashboard_customize";

    [Parameter]
    public string StatusText { get; set; } = "Listo para recibir componentes";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
