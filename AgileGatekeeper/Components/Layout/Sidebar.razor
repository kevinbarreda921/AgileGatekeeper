@inject NavigationManager Navigation
@inject IAuthService AuthService

<aside class="@GetSidebarClasses()" id="sidebar">
    <!-- Top Brand & Collapse Trigger -->
    <div>
        <div class="flex items-center justify-between px-2 mb-8">
            <a href="/" class="flex items-center gap-3 overflow-hidden">
                <img src="/images/logo-sidebar.png"
                     alt="Agile Gatekeeper"
                     class="@(IsCollapsed ? "h-8 w-8 object-contain" : "h-9 max-w-full object-contain")"
                     onerror="this.style.display='none'; document.getElementById('brand-fallback').classList.remove('hidden');" />
                <div id="brand-fallback" class="hidden items-center gap-2 font-display font-bold text-blue-600 dark:text-blue-400 text-lg">
                    <span class="material-symbols-outlined text-2xl">shield</span>
                    @if (!IsCollapsed)
                    {
                        <span>AgileGate</span>
                    }
                </div>
            </a>

            <!-- Desktop Collapse Button -->
            <button type="button"
                    @onclick="ToggleCollapse"
                    class="hidden md:flex w-7 h-7 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 items-center justify-center transition-colors"
                    title="@(IsCollapsed ? "Expandir menú" : "Colapsar menú")">
                <span class="material-symbols-outlined text-[17px]">
                    @(IsCollapsed ? "chevron_right" : "chevron_left")
                </span>
            </button>

            <!-- Mobile Close Button -->
            <button type="button"
                    @onclick="CloseMobile"
                    class="md:hidden flex w-8 h-8 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">close</span>
            </button>
        </div>

        <!-- Main Navigation Items -->
        <nav class="space-y-1.5">
            <!-- Dashboard -->
            <NavLink href="" Match="NavLinkMatch.All" class="@GetNavLinkClass("")">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-[19px] @(IsActive("") ? "text-white filled" : "text-slate-500 group-hover:text-slate-700 dark:group-hover:text-slate-300")">home</span>
                    @if (!IsCollapsed)
                    {
                        <span class="sidebar-text">Dashboard</span>
                    }
                </div>
                @if (!IsCollapsed && IsActive(""))
                {
                    <span class="material-symbols-outlined text-[16px] text-white/90">chevron_right</span>
                }
            </NavLink>

            <!-- Orders -->
            <NavLink href="orders" Match="NavLinkMatch.Prefix" class="@GetNavLinkClass("orders")">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-[19px] @(IsActive("orders") ? "text-white filled" : "text-slate-500 group-hover:text-slate-700 dark:group-hover:text-slate-300")">local_shipping</span>
                    @if (!IsCollapsed)
                    {
                        <span class="sidebar-text">Orders</span>
                    }
                </div>
                @if (!IsCollapsed && IsActive("orders"))
                {
                    <span class="material-symbols-outlined text-[16px] text-white/90">chevron_right</span>
                }
            </NavLink>

            <!-- Shipments with Submenu -->
            <div>
                <button type="button"
                        @onclick="ToggleShipmentsSubmenu"
                        class="@GetShipmentsToggleClass()">
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-[19px] @(IsActive("shipments") ? "text-white filled" : "text-slate-500 group-hover:text-slate-700 dark:group-hover:text-slate-300")">swap_horiz</span>
                        @if (!IsCollapsed)
                        {
                            <span class="sidebar-text">Shipments</span>
                        }
                    </div>
                    @if (!IsCollapsed)
                    {
                        <span class="material-symbols-outlined text-[16px] transition-transform duration-200 @(isShipmentsExpanded ? "rotate-90" : "")">
                            chevron_right
                        </span>
                    }
                </button>

                @if (!IsCollapsed && isShipmentsExpanded)
                {
                    <div class="ml-8 mt-1 space-y-1 border-l-2 border-slate-100 dark:border-slate-800/80 pl-2">
                        <NavLink href="shipments" Match="NavLinkMatch.All" class="block px-3 py-1.5 rounded-lg text-[12.5px] text-slate-500 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
                            Todos los envíos
                        </NavLink>
                        <NavLink href="shipments?status=in-transit" class="block px-3 py-1.5 rounded-lg text-[12.5px] text-slate-500 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
                            En tránsito
                        </NavLink>
                        <NavLink href="shipments?status=delivered" class="block px-3 py-1.5 rounded-lg text-[12.5px] text-slate-500 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
                            Entregados
                        </NavLink>
                    </div>
                }
            </div>

            <!-- Map Overview -->
            <NavLink href="map" Match="NavLinkMatch.Prefix" class="@GetNavLinkClass("map")">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-[19px] @(IsActive("map") ? "text-white filled" : "text-slate-500 group-hover:text-slate-700 dark:group-hover:text-slate-300")">explore</span>
                    @if (!IsCollapsed)
                    {
                        <span class="sidebar-text">Map Overview</span>
                    }
                </div>
                @if (!IsCollapsed && IsActive("map"))
                {
                    <span class="material-symbols-outlined text-[16px] text-white/90">chevron_right</span>
                }
            </NavLink>

            <!-- Messages (with notification badge) -->
            <NavLink href="messages" Match="NavLinkMatch.Prefix" class="@GetNavLinkClass("messages")">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-[19px] @(IsActive("messages") ? "text-white filled" : "text-slate-500 group-hover:text-slate-700 dark:group-hover:text-slate-300")">mail</span>
                    @if (!IsCollapsed)
                    {
                        <span class="sidebar-text">Messages</span>
                    }
                </div>
                @if (!IsCollapsed)
                {
                    <span class="w-5 h-5 rounded-full bg-blue-600/90 text-white text-[11px] font-semibold flex items-center justify-center shadow-xs">
                        @AuthService.CurrentUser.UnreadMessagesCount
                    </span>
                }
            </NavLink>

            <!-- Settings -->
            <NavLink href="settings" Match="NavLinkMatch.Prefix" class="@GetNavLinkClass("settings")">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-[19px] @(IsActive("settings") ? "text-white filled" : "text-slate-500 group-hover:text-slate-700 dark:group-hover:text-slate-300")">settings</span>
                    @if (!IsCollapsed)
                    {
                        <span class="sidebar-text">Settings</span>
                    }
                </div>
                @if (!IsCollapsed && IsActive("settings"))
                {
                    <span class="material-symbols-outlined text-[16px] text-white/90">chevron_right</span>
                }
            </NavLink>
        </nav>
    </div>

    <!-- Bottom User Profile & Logout -->
    <div class="space-y-3 pt-4 border-t border-slate-100 dark:border-slate-800/70">
        <!-- Profile Widget -->
        <UserProfileWidget IsCollapsed="IsCollapsed" />

        <!-- Logout Button -->
        <button type="button"
                @onclick="HandleLogout"
                class="w-full flex items-center gap-2.5 px-3 py-2 rounded-xl text-slate-500 dark:text-slate-400 hover:text-red-600 dark:hover:text-red-400 hover:bg-red-50/70 dark:hover:bg-red-950/20 text-[13px] font-medium transition-all group"
                title="Cerrar sesión">
            <span class="material-symbols-outlined text-[18px] text-slate-400 group-hover:text-red-500 transition-colors">logout</span>
            @if (!IsCollapsed)
            {
                <span class="sidebar-text">Cerrar sesión</span>
            }
        </button>
    </div>
</aside>

@code {
    [Parameter]
    public bool IsCollapsed { get; set; } = false;

    [Parameter]
    public EventCallback<bool> IsCollapsedChanged { get; set; }

    [Parameter]
    public bool IsMobileOpen { get; set; } = false;

    [Parameter]
    public EventCallback OnCloseMobile { get; set; }

    private bool isShipmentsExpanded = false;

    private async Task ToggleCollapse()
    {
        IsCollapsed = !IsCollapsed;
        await IsCollapsedChanged.InvokeAsync(IsCollapsed);
    }

    private async Task CloseMobile()
    {
        if (OnCloseMobile.HasDelegate)
        {
            await OnCloseMobile.InvokeAsync();
        }
    }

    private void ToggleShipmentsSubmenu()
    {
        if (IsCollapsed)
        {
            IsCollapsed = false;
        }
        isShipmentsExpanded = !isShipmentsExpanded;
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    private bool IsActive(string route)
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/');
        var cleanRoute = route.Trim('/');

        if (string.IsNullOrEmpty(cleanRoute))
        {
            return string.IsNullOrEmpty(relative);
        }

        return relative.Equals(cleanRoute, StringComparison.OrdinalIgnoreCase) ||
               relative.StartsWith(cleanRoute + "/", StringComparison.OrdinalIgnoreCase);
    }

    private string GetNavLinkClass(string route)
    {
        var active = IsActive(route);
        if (active)
        {
            return "flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-blue-600 text-white font-medium text-[13.5px] shadow-sm transition-all duration-150 cursor-pointer";
        }

        return "flex items-center justify-between px-3.5 py-2.5 rounded-xl text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-slate-800/50 text-[13.5px] font-medium transition-colors group cursor-pointer";
    }

    private string GetShipmentsToggleClass()
    {
        var active = IsActive("shipments");
        if (active)
        {
            return "w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-blue-600 text-white font-medium text-[13.5px] shadow-sm transition-all duration-150 cursor-pointer";
        }

        return "w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-slate-800/50 text-[13.5px] font-medium transition-colors group cursor-pointer";
    }

    private string GetSidebarClasses()
    {
        var widthClass = IsCollapsed ? "w-[72px]" : "w-64";
        var mobileClass = IsMobileOpen ? "translate-x-0" : "-translate-x-full md:translate-x-0";

        return $"{widthClass} fixed md:static inset-y-0 left-0 z-40 bg-white dark:bg-[#0c1322] border-r border-slate-100 dark:border-slate-800/70 flex flex-col justify-between shrink-0 px-4 py-6 transition-all duration-200 {mobileClass}";
    }
}
