@inject IAuthService AuthService

<div class="flex items-center gap-3 px-2 transition-all">
    <div class="w-9 h-9 rounded-full overflow-hidden ring-2 ring-slate-100 dark:ring-slate-800 shrink-0 bg-slate-100 dark:bg-slate-800 relative">
        <img alt="@AuthService.CurrentUser.Name"
             class="w-full h-full object-cover"
             src="@AuthService.CurrentUser.AvatarUrl"
             onerror="this.src='https://ui-avatars.com/api/?name=Jack+Ryad&background=2563eb&color=fff';" />
        <span class="absolute bottom-0 right-0 w-2 h-2 rounded-full bg-emerald-500 ring-1 ring-white dark:ring-slate-900"></span>
    </div>
    @if (!IsCollapsed)
    {
        <div class="flex flex-col min-w-0 transition-opacity duration-150">
            <span class="text-[13.5px] font-bold text-slate-900 dark:text-white leading-tight truncate">
                @AuthService.CurrentUser.Name
            </span>
            <span class="text-[11px] text-slate-400 dark:text-slate-500 font-normal leading-tight mt-0.5 truncate">
                @AuthService.CurrentUser.Location
            </span>
        </div>
    }
</div>

@code {
    [Parameter]
    public bool IsCollapsed { get; set; }
}
