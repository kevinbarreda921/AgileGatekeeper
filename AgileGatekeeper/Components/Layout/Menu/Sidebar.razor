@inject NavigationManager Navigation
@inject IAuthService AuthService
@implements IDisposable

<aside class="@GetSidebarClasses()" id="sidebar">
    <!-- Top Brand & Collapse Trigger -->
    <div>
        <div class="flex items-center justify-between px-2 mb-8">
            <a href="/" class="flex items-center gap-3 overflow-hidden">
                <img src="/images/logo-sidebar.png"
                     alt="Agile Gatekeeper"
                     class="@(IsCollapsed ? "h-8 w-8 object-contain" : "h-9 max-w-full object-contain")"
                     onerror="this.style.display='none'; document.getElementById('brand-fallback').classList.remove('hidden');" />
                <div id="brand-fallback" class="hidden items-center gap-2 font-display font-bold text-blue-600 dark:text-blue-400 text-lg">
                    <span class="material-symbols-outlined text-2xl">shield</span>
                    @if (!IsCollapsed)
                    {
                        <span>AgileGate</span>
                    }
                </div>
            </a>

            <!-- Desktop Collapse Button -->
            <button type="button"
                    @onclick="ToggleCollapse"
                    class="hidden md:flex w-7 h-7 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 items-center justify-center transition-colors"
                    title="@(IsCollapsed ? "Expandir menú" : "Colapsar menú")">
                <span class="material-symbols-outlined text-[17px]">
                    @(IsCollapsed ? "chevron_right" : "chevron_left")
                </span>
            </button>

            <!-- Mobile Close Button -->
            <button type="button"
                    @onclick="CloseMobile"
                    class="md:hidden flex w-8 h-8 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">close</span>
            </button>
        </div>

        <!-- Main Navigation Items -->
        <nav class="space-y-1.5">
            <SidebarNavItem Href="" Icon="home" Label="Dashboard" Match="NavLinkMatch.All" IsCollapsed="IsCollapsed" />
            <SidebarNavItem Href="orders" Icon="local_shipping" Label="Orders" IsCollapsed="IsCollapsed" />
            <SidebarNavItem Href="shipments" Icon="swap_horiz" Label="Shipments" IsCollapsed="IsCollapsed" />
            <SidebarNavItem Href="map" Icon="explore" Label="Map Overview" IsCollapsed="IsCollapsed" />
            <SidebarNavItem Href="messages" Icon="mail" Label="Messages" BadgeCount="@AuthService.CurrentUser.UnreadMessagesCount" IsCollapsed="IsCollapsed" />
            <SidebarNavItem Href="settings" Icon="settings" Label="Settings" IsCollapsed="IsCollapsed" />
        </nav>
    </div>

    <!-- Bottom User Profile & Logout -->
    <div class="space-y-3 pt-4 border-t border-slate-100 dark:border-slate-800/70">
        <UserProfileWidget IsCollapsed="IsCollapsed" />

        <button type="button"
                @onclick="HandleLogout"
                class="w-full flex items-center gap-2.5 px-3 py-2 rounded-xl text-slate-500 dark:text-slate-400 hover:text-red-600 dark:hover:text-red-400 hover:bg-red-50/70 dark:hover:bg-red-950/20 text-[13px] font-medium transition-all group cursor-pointer"
                title="Cerrar sesión">
            <span class="material-symbols-outlined text-[18px] text-slate-400 group-hover:text-red-500 transition-colors">logout</span>
            @if (!IsCollapsed)
            {
                <span class="sidebar-text">Cerrar sesión</span>
            }
        </button>
    </div>
</aside>

@code {
    [Parameter]
    public bool IsCollapsed { get; set; }

    [Parameter]
    public EventCallback<bool> IsCollapsedChanged { get; set; }

    [Parameter]
    public bool IsMobileOpen { get; set; }

    [Parameter]
    public EventCallback OnCloseMobile { get; set; }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task ToggleCollapse()
    {
        IsCollapsed = !IsCollapsed;
        await IsCollapsedChanged.InvokeAsync(IsCollapsed);
    }

    private async Task CloseMobile()
    {
        if (OnCloseMobile.HasDelegate)
        {
            await OnCloseMobile.InvokeAsync();
        }
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    private string GetSidebarClasses()
    {
        var widthClass = IsCollapsed ? "w-[72px]" : "w-64";
        var mobileClass = IsMobileOpen ? "translate-x-0" : "-translate-x-full md:translate-x-0";

        return $"{widthClass} fixed md:static inset-y-0 left-0 z-40 bg-white dark:bg-[#0c1322] border-r border-slate-100 dark:border-slate-800/70 flex flex-col justify-between shrink-0 px-4 py-6 transition-all duration-200 {mobileClass}";
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
