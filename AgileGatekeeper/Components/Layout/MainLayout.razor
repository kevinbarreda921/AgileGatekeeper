@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject NavigationManager Navigation
@implements IDisposable

<div class="flex h-screen w-screen overflow-hidden bg-[var(--canvas-bg)] text-slate-800 dark:text-slate-100 transition-colors duration-200">
    <!-- Mobile Backdrop -->
    @if (isMobileSidebarOpen)
    {
        <div class="fixed inset-0 z-30 bg-slate-900/40 backdrop-blur-xs md:hidden transition-opacity"
             @onclick="CloseMobileSidebar"></div>
    }

    <!-- 1. BARRA LATERAL (Componente Modular en Layout/Menu) -->
    <Sidebar @bind-IsCollapsed="isSidebarCollapsed"
             IsMobileOpen="isMobileSidebarOpen"
             OnCloseMobile="CloseMobileSidebar" />

    <!-- 2. CONTENEDOR PRINCIPAL -->
    <div class="flex-1 flex flex-col h-full overflow-hidden bg-slate-50/50 dark:bg-[#090d16] min-w-0">
        <!-- HEADER (Componente Modular en Layout/Menu) -->
        <Header OnOpenMobileSidebar="OpenMobileSidebar"
                OnCreateOrder="NavigateToOrders" />

        <!-- 3. ÁREA DE CONTENIDO CENTRAL -->
        <main class="flex-1 overflow-y-auto p-4 sm:p-6 md:p-8 flex flex-col">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ha ocurrido un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool isSidebarCollapsed;
    private bool isMobileSidebarOpen;

    protected override void OnInitialized()
    {
        AuthService.OnAuthStateChanged += HandleAuthStateChanged;
    }

    private void HandleAuthStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OpenMobileSidebar()
    {
        isMobileSidebarOpen = true;
    }

    private void CloseMobileSidebar()
    {
        isMobileSidebarOpen = false;
    }

    private void NavigateToOrders()
    {
        Navigation.NavigateTo("/orders");
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= HandleAuthStateChanged;
    }
}
