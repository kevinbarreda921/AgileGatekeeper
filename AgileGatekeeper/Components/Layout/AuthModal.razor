@inject IAuthService AuthService
@inject NavigationManager Navigation

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 bg-slate-900/40 dark:bg-black/70 backdrop-blur-sm flex items-center justify-center p-4 transition-all duration-200 animate-fadeIn"
         @onclick="HandleBackdropClick">
        <div class="w-full max-w-[390px] bg-white dark:bg-[#0f172a] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-modal p-7 relative transition-all duration-200"
             @onclick:stopPropagation="true">
            <!-- Close / Back button -->
            <button type="button"
                    @onclick="Close"
                    aria-label="Cerrar modal"
                    class="absolute top-4 right-4 p-1 rounded-md text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                <span class="material-symbols-outlined text-[18px]">close</span>
            </button>

            <!-- Brand Header -->
            <div class="flex flex-col items-center text-center mb-6">
                <div class="w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center text-white mb-3 shadow-sm">
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                        <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
                    </svg>
                </div>
                <h3 class="font-display text-[18px] font-semibold text-slate-900 dark:text-white tracking-tight">
                    Agile Gatekeeper
                </h3>
                <p class="text-[12.5px] text-slate-400 dark:text-slate-400 mt-0.5">
                    Ingresa tus credenciales para continuar
                </p>
            </div>

            <!-- Single Sign-On (SSO) Minimalist Buttons -->
            <div class="space-y-2 mb-4">
                <button type="button"
                        @onclick="HandleGoogleLogin"
                        class="w-full flex items-center justify-center gap-2.5 py-2 px-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/50 hover:bg-slate-50 dark:hover:bg-slate-800 text-[12.5px] font-medium text-slate-700 dark:text-slate-200 transition-colors shadow-subtle">
                    <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
                        <path d="M12.545 10.239v3.821h5.445c-0.712 2.315-2.647 3.972-5.445 3.972-3.332 0-6.033-2.701-6.033-6.032s2.701-6.032 6.033-6.032c1.498 0 2.866 0.549 3.921 1.453l2.814-2.814c-1.787-1.664-4.148-2.673-6.735-2.673-5.522 0-10 4.477-10 10s4.478 10 10 10c8.396 0 10.249-7.85 9.426-11.727h-9.426z" fill="currentColor" />
                    </svg>
                    <span>Continuar con Google</span>
                </button>

                <button type="button"
                        @onclick="HandleMicrosoftLogin"
                        class="w-full flex items-center justify-center gap-2.5 py-2 px-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/50 hover:bg-slate-50 dark:hover:bg-slate-800 text-[12.5px] font-medium text-slate-700 dark:text-slate-200 transition-colors shadow-subtle">
                    <svg class="w-4 h-4 shrink-0" viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="1" y="1" width="9" height="9" fill="#F25022" />
                        <rect x="11" y="1" width="9" height="9" fill="#7FBA00" />
                        <rect x="1" y="11" width="9" height="9" fill="#00A4EF" />
                        <rect x="11" y="11" width="9" height="9" fill="#FFB900" />
                    </svg>
                    <span>Continuar con Microsoft</span>
                </button>
            </div>

            <!-- Divider -->
            <div class="relative flex items-center justify-center my-4">
                <div class="border-t border-slate-200 dark:border-slate-800 w-full"></div>
                <span class="bg-white dark:bg-[#0f172a] px-2 text-[11px] font-medium text-slate-400 uppercase tracking-wider relative">
                    o con email
                </span>
            </div>

            <!-- Form Inputs -->
            <EditForm Model="@loginModel" OnValidSubmit="HandleLoginSubmit" class="space-y-3">
                <DataAnnotationsValidator />

                <div>
                    <label class="block text-[11.5px] font-medium text-slate-700 dark:text-slate-300 mb-1">Correo corporativo</label>
                    <InputText @bind-Value="loginModel.Email"
                               placeholder="nombre@empresa.com"
                               class="w-full h-9 px-3 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-[12.5px] text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600/30 transition-all" />
                    <ValidationMessage For="@(() => loginModel.Email)" />
                </div>

                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="block text-[11.5px] font-medium text-slate-700 dark:text-slate-300">Contraseña</label>
                        <a href="javascript:void(0)" class="text-[11px] text-blue-600 dark:text-blue-400 hover:underline">¿Olvidaste tu contraseña?</a>
                    </div>
                    <InputText @bind-Value="loginModel.Password"
                               type="password"
                               placeholder="••••••••"
                               class="w-full h-9 px-3 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-[12.5px] text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600/30 transition-all" />
                    <ValidationMessage For="@(() => loginModel.Password)" />
                </div>

                <button type="submit"
                        disabled="@isLoading"
                        class="w-full h-9 mt-2 rounded-lg bg-blue-600 hover:bg-blue-700 active:scale-[0.99] text-white text-[12.5px] font-medium tracking-tight shadow-sm transition-all duration-150 flex items-center justify-center gap-2 cursor-pointer">
                    @if (isLoading)
                    {
                        <span class="inline-block w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                        <span>Verificando...</span>
                    }
                    else
                    {
                        <span>Iniciar Sesión</span>
                    }
                </button>
            </EditForm>

            <!-- Minimalist Legal Note -->
            <p class="text-[11px] text-center text-slate-400 dark:text-slate-500 mt-5 leading-relaxed">
                Protegido por políticas de cifrado empresarial Agile Gatekeeper SSO.
            </p>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; } = false;

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    private LoginModel loginModel = new();
    private bool isLoading = false;

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task HandleBackdropClick()
    {
        await Close();
    }

    private async Task HandleLoginSubmit()
    {
        isLoading = true;
        await AuthService.LoginAsync(loginModel.Email, loginModel.Password);
        isLoading = false;
        await Close();
    }

    private async Task HandleMicrosoftLogin()
    {
        isLoading = true;
        await AuthService.LoginWithMicrosoftAsync();
        isLoading = false;
        await Close();
    }

    private async Task HandleGoogleLogin()
    {
        isLoading = true;
        await AuthService.LoginAsync("google.user@agilegatekeeper.io", "password123");
        isLoading = false;
        await Close();
    }
}
