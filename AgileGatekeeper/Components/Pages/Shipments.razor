@page "/shipments"
@rendermode InteractiveServer

<PageTitle>Shipments - Agile Gatekeeper</PageTitle>

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="font-display text-xl font-bold text-slate-900 dark:text-white">Monitoreo de Envíos</h2>
            <p class="text-xs text-slate-400 dark:text-slate-500">Trazabilidad en tiempo real de rutas terrestres y aéreas</p>
        </div>
        <div class="flex items-center gap-2">
            <span class="text-xs text-slate-400">Actualizado hace 2m</span>
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        </div>
    </div>

    <!-- Active Shipments Container -->
    <div class="w-full min-h-[360px] rounded-2xl border border-dashed border-slate-200/90 dark:border-slate-800/80 bg-white/40 dark:bg-slate-900/20 flex flex-col items-center justify-center p-8 text-center transition-all">
        <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-slate-800 border border-blue-100 dark:border-slate-700/60 flex items-center justify-center mb-3 text-blue-600 dark:text-blue-400 shadow-xs">
            <span class="material-symbols-outlined text-[24px]">swap_horiz</span>
        </div>
        <h3 class="font-display text-[17px] font-bold text-slate-900 dark:text-white mb-1">
            Módulo de Envíos en Ejecución
        </h3>
        <p class="text-[12.5px] text-slate-400 max-w-sm mb-4">
            Los despachos y estados de aduana están sincronizados con la pasarela central de Agile Gatekeeper.
        </p>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 border border-slate-200/70 dark:border-slate-700 text-slate-600 dark:text-slate-300 text-[11px] font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            <span>84 envíos activos actualmente</span>
        </div>
    </div>
</div>
