@page "/"
@rendermode InteractiveServer
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Dashboard - Agile Gatekeeper</PageTitle>

<div class="space-y-6">
    <!-- Top Stats / Metric Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Metric 1: Total Orders -->
        <div class="bg-white dark:bg-[#0f172a] rounded-2xl border border-slate-200/80 dark:border-slate-800 p-5 shadow-subtle hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Total Pedidos</span>
                <span class="w-8 h-8 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[18px]">shopping_bag</span>
                </span>
            </div>
            <div class="mt-3 flex items-baseline gap-2">
                <span class="text-2xl font-bold font-display text-slate-900 dark:text-white">1,248</span>
                <span class="text-xs font-semibold text-emerald-600 flex items-center">
                    <span class="material-symbols-outlined text-[14px]">trending_up</span> +12.5%
                </span>
            </div>
            <span class="text-[11.5px] text-slate-400 dark:text-slate-500 mt-1 block">Comparado con mes anterior</span>
        </div>

        <!-- Metric 2: Shipments In Transit -->
        <div class="bg-white dark:bg-[#0f172a] rounded-2xl border border-slate-200/80 dark:border-slate-800 p-5 shadow-subtle hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">En Tránsito</span>
                <span class="w-8 h-8 rounded-xl bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[18px]">local_shipping</span>
                </span>
            </div>
            <div class="mt-3 flex items-baseline gap-2">
                <span class="text-2xl font-bold font-display text-slate-900 dark:text-white">84</span>
                <span class="text-xs font-semibold text-amber-600 flex items-center">
                    <span class="material-symbols-outlined text-[14px]">schedule</span> 14 hoy
                </span>
            </div>
            <span class="text-[11.5px] text-slate-400 dark:text-slate-500 mt-1 block">Rutas activas monitoreadas</span>
        </div>

        <!-- Metric 3: Delivered Parcels -->
        <div class="bg-white dark:bg-[#0f172a] rounded-2xl border border-slate-200/80 dark:border-slate-800 p-5 shadow-subtle hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Entregados</span>
                <span class="w-8 h-8 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[18px]">task_alt</span>
                </span>
            </div>
            <div class="mt-3 flex items-baseline gap-2">
                <span class="text-2xl font-bold font-display text-slate-900 dark:text-white">1,164</span>
                <span class="text-xs font-semibold text-emerald-600 flex items-center">
                    <span class="material-symbols-outlined text-[14px]">check</span> 98.4%
                </span>
            </div>
            <span class="text-[11.5px] text-slate-400 dark:text-slate-500 mt-1 block">Tasa de entrega a tiempo</span>
        </div>

        <!-- Metric 4: Active Gateways / Security -->
        <div class="bg-white dark:bg-[#0f172a] rounded-2xl border border-slate-200/80 dark:border-slate-800 p-5 shadow-subtle hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Gateways Activas</span>
                <span class="w-8 h-8 rounded-xl bg-purple-50 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[18px]">verified_user</span>
                </span>
            </div>
            <div class="mt-3 flex items-baseline gap-2">
                <span class="text-2xl font-bold font-display text-slate-900 dark:text-white">6 / 6</span>
                <span class="text-xs font-semibold text-emerald-600 flex items-center">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1 animate-ping"></span> 100% OK
                </span>
            </div>
            <span class="text-[11.5px] text-slate-400 dark:text-slate-500 mt-1 block">Seguridad y cifrado activo</span>
        </div>
    </div>

    <!-- Main Content Container (Fiel a la Referencia) -->
    <div class="w-full min-h-[440px] rounded-2xl border border-dashed border-slate-200/90 dark:border-slate-800/80 bg-white/40 dark:bg-slate-900/20 flex flex-col items-center justify-center p-8 text-center transition-all">
        <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-slate-800 border border-blue-100 dark:border-slate-700/60 flex items-center justify-center mb-3 text-blue-600 dark:text-blue-400 shadow-xs">
            <span class="material-symbols-outlined text-[24px]">dashboard_customize</span>
        </div>
        <h2 class="font-display text-[18px] font-bold text-slate-900 dark:text-white tracking-tight mb-1">
            Espacio de Trabajo Agile Gatekeeper
        </h2>
        <p class="text-[13px] text-slate-400 dark:text-slate-500 max-w-sm leading-normal mb-4">
            Espacio despejado y listo para integrar los paneles y módulos operativos del sistema.
        </p>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100/80 dark:bg-slate-800 border border-slate-200/70 dark:border-slate-700 text-slate-600 dark:text-slate-300 text-[11.5px] font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-600 animate-pulse"></span>
            <span>Listo para recibir componentes</span>
        </div>
    </div>
</div>
