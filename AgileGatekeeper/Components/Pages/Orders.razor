@page "/orders"
@rendermode InteractiveServer

<PageTitle>Orders - Agile Gatekeeper</PageTitle>

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="font-display text-xl font-bold text-slate-900 dark:text-white">Gestión de Pedidos</h2>
            <p class="text-xs text-slate-400 dark:text-slate-500">Supervisa y administra el ciclo de vida de los pedidos corporativos</p>
        </div>
        <button class="h-9 px-4 rounded-full bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold shadow-sm transition-all flex items-center gap-1.5 cursor-pointer">
            <span class="material-symbols-outlined text-[16px]">add</span> Nuevo Pedido
        </button>
    </div>

    <!-- Orders Table / List Card -->
    <div class="bg-white dark:bg-[#0f172a] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-subtle overflow-hidden">
        <div class="p-4 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Historial Reciente</span>
            <span class="text-xs text-slate-400">Mostrando 5 registros</span>
        </div>
        <div class="divide-y divide-slate-100 dark:divide-slate-800/80">
            @foreach (var order in sampleOrders)
            {
                <div class="p-4 flex items-center justify-between hover:bg-slate-50/60 dark:hover:bg-slate-850 transition-colors">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl bg-blue-50 dark:bg-slate-800 text-blue-600 dark:text-blue-400 flex items-center justify-center font-semibold text-xs">
                            #@order.Id
                        </div>
                        <div>
                            <span class="text-sm font-semibold text-slate-900 dark:text-white block">@order.Customer</span>
                            <span class="text-xs text-slate-400">@order.Destination</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-4">
                        <span class="text-xs px-2.5 py-1 rounded-full font-medium @order.StatusBadgeClass">
                            @order.Status
                        </span>
                        <span class="text-sm font-bold text-slate-800 dark:text-slate-200">@order.Total</span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private record OrderItem(int Id, string Customer, string Destination, string Status, string StatusBadgeClass, string Total);

    private readonly List<OrderItem> sampleOrders = new()
    {
        new(1042, "Apex Logistics Corp", "Chicago, IL", "Completado", "bg-emerald-50 text-emerald-600 dark:bg-emerald-950/40 dark:text-emerald-400", "$4,820.00"),
        new(1043, "Nordic Supply Chain", "Seattle, WA", "En Tránsito", "bg-amber-50 text-amber-600 dark:bg-amber-950/40 dark:text-amber-400", "$2,150.50"),
        new(1044, "BlueHorizon Retail", "Miami, FL", "Pendiente", "bg-blue-50 text-blue-600 dark:bg-blue-950/40 dark:text-blue-400", "$950.00"),
        new(1045, "Quantum Freight Inc", "Dallas, TX", "Completado", "bg-emerald-50 text-emerald-600 dark:bg-emerald-950/40 dark:text-emerald-400", "$7,320.00"),
        new(1046, "Vanguard Express", "Denver, CO", "En Tránsito", "bg-amber-50 text-amber-600 dark:bg-amber-950/40 dark:text-amber-400", "$1,450.00")
    };
}
