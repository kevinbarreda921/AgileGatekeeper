@page "/settings"
@rendermode InteractiveServer
@inject IAuthService AuthService
@inject IThemeService ThemeService

<PageTitle>Settings - Agile Gatekeeper</PageTitle>

<div class="space-y-6 max-w-4xl">
    <div>
        <h2 class="font-display text-xl font-bold text-slate-900 dark:text-white">Configuración del Sistema</h2>
        <p class="text-xs text-slate-400 dark:text-slate-500">Preferencias de cuenta, apariencia y seguridad empresarial</p>
    </div>

    <!-- Profile Overview Card -->
    <div class="bg-white dark:bg-[#0f172a] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-subtle p-6 space-y-6">
        <h3 class="text-sm font-bold text-slate-900 dark:text-white border-b border-slate-100 dark:border-slate-800 pb-3">
            Perfil de Usuario
        </h3>
        <div class="flex items-center gap-4">
            <img src="@AuthService.CurrentUser.AvatarUrl"
                 alt="@AuthService.CurrentUser.Name"
                 class="w-16 h-16 rounded-full object-cover ring-4 ring-blue-50 dark:ring-blue-950/40"
                 onerror="this.src='https://ui-avatars.com/api/?name=Jack+Ryad&background=2563eb&color=fff';" />
            <div>
                <h4 class="font-bold text-slate-900 dark:text-white text-base">@AuthService.CurrentUser.Name</h4>
                <p class="text-xs text-slate-500 dark:text-slate-400">@AuthService.CurrentUser.Email</p>
                <span class="inline-block mt-1 text-[11px] font-semibold px-2 py-0.5 rounded-full bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400">
                    @AuthService.CurrentUser.Role
                </span>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1">Ubicación Asignada</label>
                <input type="text"
                       value="@AuthService.CurrentUser.Location"
                       readonly
                       class="w-full h-9 px-3 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-xs text-slate-700 dark:text-slate-300" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1">Tema Visual</label>
                <div class="flex items-center gap-3 h-9">
                    <button type="button"
                            @onclick="() => ThemeService.SetThemeAsync(false)"
                            class="px-3 py-1.5 rounded-lg text-xs font-medium border @(!ThemeService.IsDarkMode ? "border-blue-600 bg-blue-50 text-blue-600 dark:bg-blue-950" : "border-slate-200 text-slate-600 dark:border-slate-700 dark:text-slate-300")">
                        Modo Claro
                    </button>
                    <button type="button"
                            @onclick="() => ThemeService.SetThemeAsync(true)"
                            class="px-3 py-1.5 rounded-lg text-xs font-medium border @(ThemeService.IsDarkMode ? "border-blue-600 bg-blue-50 text-blue-600 dark:bg-blue-950" : "border-slate-200 text-slate-600 dark:border-slate-700 dark:text-slate-300")">
                        Modo Oscuro
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
