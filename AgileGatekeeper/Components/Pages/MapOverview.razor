@page "/map"
@rendermode InteractiveServer

<PageTitle>Map Overview - Agile Gatekeeper</PageTitle>

<div class="space-y-6">
    <div>
        <h2 class="font-display text-xl font-bold text-slate-900 dark:text-white">Mapa de Cobertura Global</h2>
        <p class="text-xs text-slate-400 dark:text-slate-500">Visualización geográfica de nodos, almacenes y transportistas en ruta</p>
    </div>

    <div class="w-full min-h-[420px] rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-[#0f172a] shadow-subtle p-6 flex flex-col items-center justify-center text-center relative overflow-hidden">
        <div class="w-14 h-14 rounded-2xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center mb-4">
            <span class="material-symbols-outlined text-[30px]">explore</span>
        </div>
        <h3 class="font-display text-lg font-bold text-slate-900 dark:text-white mb-1">
            Red de Distribución Activa
        </h3>
        <p class="text-xs text-slate-400 max-w-md mb-5 leading-relaxed">
            Se han detectado 12 centros de distribución y 84 vehículos en movimiento a través de los corredores logísticos autorizados.
        </p>
        <div class="flex items-center gap-3">
            <span class="px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-600 dark:bg-emerald-950/40 dark:text-emerald-400">
                Latencia: 24ms
            </span>
            <span class="px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-600 dark:bg-blue-950/40 dark:text-blue-400">
                GPS: En línea
            </span>
        </div>
    </div>
</div>
