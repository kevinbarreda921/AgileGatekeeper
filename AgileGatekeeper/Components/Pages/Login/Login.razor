@page "/login"
@layout LoginLayout
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Login - Agile Gatekeeper</PageTitle>

<main class="w-full min-h-screen h-full grid grid-cols-1 md:grid-cols-2 relative overflow-hidden bg-white dark:bg-[#0c1322]">
    <!-- LeftPanel (Branding & Graphic Background) -->
    <section class="wave-bg relative flex flex-col justify-between p-8 sm:p-12 md:p-16 lg:p-20 text-white overflow-hidden min-h-[380px] md:min-h-screen h-full"
             style="background: linear-gradient(145deg, rgb(59, 130, 246) 0%, rgb(37, 99, 235) 55%, rgb(29, 78, 216) 100%);">
        
        <div aria-hidden="true" class="wave-shape-1"></div>
        <div aria-hidden="true" class="wave-shape-2"></div>

        <!-- Centered Brand Logo Identity -->
        <div class="relative z-10 flex-grow flex flex-col items-center justify-center text-center w-full">
            <div class="bg-white/95 dark:bg-white/90 backdrop-blur-sm p-8 sm:p-10 rounded-2xl shadow-xl mx-auto flex items-center justify-center transition-transform hover:scale-105 duration-300">
                <img src="/images/logo-login.png"
                     alt="Agile Gatekeeper"
                     class="w-48 sm:w-56 md:w-64 h-auto max-h-44 object-contain"
                     onerror="this.src='https://lh3.googleusercontent.com/aida-public/AB6AXuAD6Tpd5bhlwy3K7ZgbF6TfQy4AmjZ_ASLjBh9TSWy37FWorA9g_ahZxIVLWY8mfpCspjkumuwnJgFBnWwbDfypzUEgcBdQKsf2J8DU2BQkMhuqqb0S6I6oOzjtKKjlnUZL2QkWgWnBMseEw4QopHX7C86dJ4e0BL9SfwBPTJu6Yl0aSFg7t6vzXn2hoethE1Febnpixd3JwmtFCk-fkHMoaMGRIoR9GeMV3mz1wug4f82DuMp52kE';" />
            </div>
        </div>

        <!-- Legal / Disclaimer Bottom Text -->
        <footer class="relative z-10 text-center pb-2">
            <p class="text-[10px] sm:text-[11px] text-white/70 leading-relaxed max-w-[280px] sm:max-w-[320px] mx-auto font-normal">
                Gestiona y centraliza tus recursos y accesos con la seguridad, rapidez y confiabilidad de Agile Gatekeeper.
            </p>
        </footer>
    </section>

    <!-- RightPanel (Login Form & Providers) -->
    <section class="bg-white dark:bg-[#0c1322] flex flex-col justify-center items-center px-6 py-12 sm:px-12 md:px-16 lg:px-24 z-20 min-h-screen h-full w-full">
        <!-- Heading Section -->
        <div class="text-center mb-8">
            <h2 class="text-2xl sm:text-3xl font-bold tracking-tight mb-2" style="color: rgb(37, 99, 235);">
                Welcome
            </h2>
            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-medium">
                @GetSubtitleText()
            </p>
        </div>

        <div class="max-w-[360px] mx-auto w-full space-y-4">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="p-3.5 rounded-xl bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-800 text-red-600 dark:text-red-400 text-xs text-center font-medium leading-relaxed">
                    @errorMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="p-3.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-600 dark:text-emerald-400 text-xs text-center font-medium leading-relaxed">
                    @successMessage
                </div>
            }

            <!-- 1. Autenticación Local (si está habilitada en appsettings) -->
            @if (AuthService.AuthConfig.IsLocalEnabled)
            {
                <EditForm Model="@loginModel" OnValidSubmit="HandleLoginSubmit" class="space-y-4 w-full">
                    <DataAnnotationsValidator />

                    <!-- Email Input Field -->
                    <div class="relative">
                        <label class="sr-only" for="email">Email</label>
                        <InputText id="email"
                                   @bind-Value="loginModel.Email"
                                   class="w-full h-11 px-6 rounded-full bg-slate-100/90 dark:bg-slate-800/80 hover:bg-slate-100 dark:hover:bg-slate-800 focus:bg-white dark:focus:bg-slate-900 text-slate-800 dark:text-slate-100 placeholder-slate-400 text-sm font-medium text-center border border-slate-200/80 dark:border-slate-700/80 focus:outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 transition-all duration-200"
                                   placeholder="Email corporativo" />
                        <ValidationMessage For="@(() => loginModel.Email)" class="text-center text-xs text-red-500 mt-1" />
                    </div>

                    <!-- Password Input Field with Visibility Toggle -->
                    <div class="relative">
                        <label class="sr-only" for="password">Password</label>
                        <InputText id="password"
                                   type="@(showPassword ? "text" : "password")"
                                   @bind-Value="loginModel.Password"
                                   class="w-full h-11 px-6 rounded-full bg-slate-100/90 dark:bg-slate-800/80 hover:bg-slate-100 dark:hover:bg-slate-800 focus:bg-white dark:focus:bg-slate-900 text-slate-800 dark:text-slate-100 placeholder-slate-400 text-sm font-medium text-center border border-slate-200/80 dark:border-slate-700/80 focus:outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 transition-all duration-200"
                                   placeholder="Password" />

                        <!-- Eye Icon Toggle Button -->
                        <button type="button"
                                @onclick="TogglePasswordVisibility"
                                aria-label="Mostrar u ocultar contraseña"
                                class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-blue-600 transition-colors focus:outline-none cursor-pointer">
                            @if (showPassword)
                            {
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                                </svg>
                            }
                            else
                            {
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                </svg>
                            }
                        </button>
                        <ValidationMessage For="@(() => loginModel.Password)" class="text-center text-xs text-red-500 mt-1" />
                    </div>

                    <!-- Submit Button -->
                    <div class="pt-2 flex justify-center">
                        <button type="submit"
                                disabled="@isLoading"
                                class="w-full h-11 rounded-full active:scale-[0.99] text-white font-semibold text-sm tracking-wide shadow-md hover:shadow-lg transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 flex items-center justify-center cursor-pointer"
                                style="background-color: rgb(37, 99, 235); box-shadow: rgba(37, 99, 235, 0.39) 0px 4px 14px 0px;">
                            @if (isLoading)
                            {
                                <span class="inline-block w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin mr-2"></span>
                                <span>Iniciando sesión...</span>
                            }
                            else
                            {
                                <span>Iniciar sesión</span>
                            }
                        </button>
                    </div>
                </EditForm>
            }
            else
            {
                <div class="p-4 rounded-2xl bg-blue-50/60 dark:bg-blue-950/30 border border-blue-100 dark:border-blue-900/40 text-center space-y-2">
                    <span class="material-symbols-outlined text-blue-600 dark:text-blue-400 text-2xl">lock</span>
                    <p class="text-xs text-slate-600 dark:text-slate-300 font-medium">
                        La autenticación local está deshabilitada por directivas de seguridad corporativa.
                    </p>
                </div>
            }

            <!-- Separador (si ambos proveedores están habilitados) -->
            @if (AuthService.AuthConfig.IsLocalEnabled && AuthService.AuthConfig.IsMicrosoftEnabled)
            {
                <div class="relative flex py-1 items-center">
                    <div class="flex-grow border-t border-slate-200 dark:border-slate-800"></div>
                    <span class="flex-shrink mx-3 text-xs text-slate-400 font-medium uppercase tracking-wider">o</span>
                    <div class="flex-grow border-t border-slate-200 dark:border-slate-800"></div>
                </div>
            }

            <!-- 2. Autenticación Microsoft (si está habilitada en appsettings) -->
            @if (AuthService.AuthConfig.IsMicrosoftEnabled)
            {
                <button type="button"
                        @onclick="HandleMicrosoftLogin"
                        disabled="@isLoading"
                        class="w-full h-11 px-4 rounded-full bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-750 active:scale-[0.99] text-slate-700 dark:text-slate-200 font-medium text-sm border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow transition-all duration-200 flex items-center justify-center gap-3 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-300 cursor-pointer">
                    <svg class="w-4 h-4 shrink-0" viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="1" y="1" width="9" height="9" fill="#F25022" />
                        <rect x="11" y="1" width="9" height="9" fill="#7FBA00" />
                        <rect x="1" y="11" width="9" height="9" fill="#00A4EF" />
                        <rect x="11" y="11" width="9" height="9" fill="#FFB900" />
                    </svg>
                    <span>Continuar con Microsoft</span>
                </button>
            }

            <!-- Footer Informativo -->
            <div class="text-center pt-3 text-xs text-slate-600 dark:text-slate-400">
                <span>¿Problemas para acceder? </span>
                <a class="font-semibold underline transition-colors cursor-pointer"
                   style="color: rgb(37, 99, 235);"
                   href="javascript:void(0)"
                   @onclick="HandleHelpNotice">
                    Soporte TI
                </a>
            </div>
        </div>
    </section>
</main>

@code {
    private LoginModel loginModel = new()
    {
        Email = "admin@agile.com"
    };

    private bool showPassword;
    private bool isLoading;
    private string? errorMessage;
    private string? successMessage;

    private string GetSubtitleText()
    {
        if (AuthService.AuthConfig.Provider.Equals("Microsoft", StringComparison.OrdinalIgnoreCase))
        {
            return "Autenticación corporativa requerida vía Microsoft";
        }
        if (AuthService.AuthConfig.Provider.Equals("Local", StringComparison.OrdinalIgnoreCase))
        {
            return "Inicia sesión con tus credenciales locales";
        }
        return "Inicia sesión con tu cuenta corporativa o correo";
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private void HandleHelpNotice()
    {
        errorMessage = null;
        successMessage = "Comuníquese con el administrador del sistema para habilitar su cuenta o validar su Tenant ID en security.usuario.";
    }

    private async Task HandleLoginSubmit()
    {
        errorMessage = null;
        successMessage = null;
        isLoading = true;

        try
        {
            var result = await AuthService.LoginAsync(loginModel.Email, loginModel.Password, loginModel.RememberMe);
            if (result.Succeeded)
            {
                Navigation.NavigateTo("/");
            }
            else
            {
                errorMessage = result.ErrorMessage ?? "Credenciales incorrectas.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al procesar autenticación: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleMicrosoftLogin()
    {
        errorMessage = null;
        successMessage = null;
        isLoading = true;

        try
        {
            // Valida contra SQL Server (security.sp_validar_usuario_microsoft)
            // Compara que el correo exista, esté activo y coincida con el Tenant ID corporativo
            var emailForMicrosoft = !string.IsNullOrWhiteSpace(loginModel.Email)
                ? loginModel.Email
                : "admin@agile.com";

            var tenantId = AuthService.AuthConfig.Microsoft.TenantId;

            var result = await AuthService.LoginWithMicrosoftAsync(emailForMicrosoft, tenantId);
            if (result.Succeeded)
            {
                Navigation.NavigateTo("/");
            }
            else
            {
                errorMessage = result.ErrorMessage ?? "Acceso denegado con Microsoft.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error en autenticación Microsoft: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
