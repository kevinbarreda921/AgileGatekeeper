@page "/messages"
@rendermode InteractiveServer
@inject IAuthService AuthService

<PageTitle>Messages - Agile Gatekeeper</PageTitle>

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="font-display text-xl font-bold text-slate-900 dark:text-white">Centro de Mensajería</h2>
            <p class="text-xs text-slate-400 dark:text-slate-500">Comunicaciones del equipo de despacho y alertas del sistema</p>
        </div>
        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-600 dark:bg-blue-950/40 dark:text-blue-400">
            @AuthService.CurrentUser.UnreadMessagesCount mensajes nuevos
        </span>
    </div>

    <div class="bg-white dark:bg-[#0f172a] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-subtle divide-y divide-slate-100 dark:divide-slate-800/80">
        <div class="p-4 flex items-start gap-4 hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
            <div class="w-10 h-10 rounded-full bg-blue-100 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0 font-bold text-xs">
                DC
            </div>
            <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between mb-1">
                    <span class="text-sm font-semibold text-slate-900 dark:text-white">Despacho Central</span>
                    <span class="text-xs text-slate-400">Hace 15m</span>
                </div>
                <p class="text-xs text-slate-600 dark:text-slate-400 leading-normal">
                    La unidad #44 ha arribado al centro de transferencia de Chicago sin novedades mecánicas.
                </p>
            </div>
        </div>

        <div class="p-4 flex items-start gap-4 hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
            <div class="w-10 h-10 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 font-bold text-xs">
                SS
            </div>
            <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between mb-1">
                    <span class="text-sm font-semibold text-slate-900 dark:text-white">Sistema de Seguridad</span>
                    <span class="text-xs text-slate-400">Hace 1h</span>
                </div>
                <p class="text-xs text-slate-600 dark:text-slate-400 leading-normal">
                    Credenciales corporativas de SSO validadas satisfactoriamente para la sesión actual.
                </p>
            </div>
        </div>
    </div>
</div>
